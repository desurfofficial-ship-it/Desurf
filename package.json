{
  "name": "desurf",
  "version": "0.1.1",
  "description": "Offline-first CLI for testing AI prompt behavior and detecting regressions",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "desurf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "desurf": "tsx src/cli.ts",
    "test:offline": "tsx src/cli.ts test --suite fixtures/basic --repeat 3",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "prompt",
    "testing",
    "regression",
    "cli",
    "offline",
    "ai"
  ],
  "author": "Desurf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desurfofficial-ship-it/Desurf.git"
  },
  "bugs": {
    "url": "https://github.com/desurfofficial-ship-it/Desurf/issues"
  },
  "homepage": "https://github.com/desurfofficial-ship-it/Desurf#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
